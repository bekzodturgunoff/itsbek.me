---
import { ViewTransitions } from 'astro:transitions';
import { languages, defaultLang } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { 
  title = 'Bekzod — Software Engineer', 
  description = 'Software engineer with 3+ years building responsive, accessible products. Specialising in React, Astro, TypeScript, Supabase, and React Native. Based in Uzbekistan — shipping full-stack web and mobile products end to end.',
  image = '/images/itsbek_brand_identity/screen.png',
  lang: propLang
} = Astro.props;

const siteUrl = Astro.site || new URL('https://itsbek.me');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imageURL = new URL(image, siteUrl);
const htmlLang = propLang || 'en';
const languageCodes = Object.keys(languages);
const buildLanguagePath = (code: string) => (code === defaultLang ? '/' : `/${code}`);
const prefetchTargets = languageCodes
  .filter((code) => code !== htmlLang)
  .map((code) => buildLanguagePath(code));

const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  ko: 'ko_KR',
  ru: 'ru_RU',
  uz: 'uz_UZ',
};
const ogLocale = ogLocaleMap[htmlLang] || 'en_US';

const hreflangs = languageCodes.map((code) => ({
  code,
  href: new URL(buildLanguagePath(code), siteUrl).href,
}));

const personJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Bekzod",
  "url": siteUrl.href,
  "jobTitle": "Software Engineer",
  "sameAs": [
    "https://github.com/bekzodturgunoff",
    "https://t.me/bekzodturgunoff",
  ],
});

const websiteJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Bekzod — Software Engineer",
  "url": siteUrl.href,
});
---
<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/x-icon" href="/images/itsbek_brand_identity/favicon_io/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/itsbek_brand_identity/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/itsbek_brand_identity/favicon_io/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/itsbek_brand_identity/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/images/itsbek_brand_identity/favicon_io/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Bekzod — Software Engineer" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <meta property="twitter:site" content="@bekzodturgunoff" />
    <meta property="twitter:creator" content="@bekzodturgunoff" />

    <!-- hreflang -->
    {hreflangs.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl).href} />

    <!-- Theme color -->
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <!-- Additional SEO -->
  <meta name="author" content="Bekzod" />
    <meta name="keywords" content="software engineer, web developer, React, Astro, Tailwind CSS, Uzbekistan, portfolio" />
    
    {prefetchTargets.map((href) => (
      <link rel="prefetch" href={href} as="document" />
    ))}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:text={personJson} is:inline></script>
    <script type="application/ld+json" set:text={websiteJson} is:inline></script>

    <title>{title}</title>
    <script is:inline>
      (() => {
        const applySystemTheme = () => {
          try {
            const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', dark);
            document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          } catch {}
        };

        applySystemTheme();

        try {
          const media = window.matchMedia('(prefers-color-scheme: dark)');
          media.addEventListener('change', applySystemTheme);
        } catch {}

        document.addEventListener('astro:after-swap', applySystemTheme);
        document.addEventListener('astro:page-load', applySystemTheme);
      })();
    </script>
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 text-base relative">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>



