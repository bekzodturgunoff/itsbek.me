---
import { getDictionary, defaultLang } from '@/i18n';
import enDict from '@/i18n/en';

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props;
const t = getDictionary(lang);

const expertSkills = new Set([
  'React', 'Astro', 'TypeScript', 'JavaScript', 'Tailwind',
  'Sass', 'HTML/CSS', 'Supabase', 'Git', 'GitHub Actions',
  'CI/CD', 'Vercel', 'Accessibility & Performance Audits',
  'Testing (Jest/Vitest)', 'Prompt Engineering',
]);
---

<div class="space-y-0">
  {t.skills.groups.map((group, gi) => (
    <div class="skills-group" data-reveal>
      <span class="skills-label">{group.title}</span>
      <div class="skills-pills">
        {group.items.map((s, ii) => {
          const enName = enDict.skills.groups[gi]?.items[ii];
          const isExpert = enName ? expertSkills.has(enName) : false;
          return (
            <span class:list={['pill', !isExpert && 'dimmed']}>
              {s}
            </span>
          );
        })}
      </div>
    </div>
  ))}
  <p class="text-xs text-neutral-400 dark:text-neutral-600 italic pt-3">* dimmed = learning / less frequent use</p>
</div>

<style>
  .skills-group {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid rgba(128, 128, 128, 0.12);
  }
  .skills-group:last-of-type {
    border-bottom: none;
  }
  .skills-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted, #94a3b8);
    min-width: 80px;
    padding-top: 0.25rem;
    flex-shrink: 0;
  }
  .skills-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill {
    font-size: 0.8125rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    background: transparent;
    color: var(--color-fg, #171717);
  }
  :global(.dark) .pill {
    color: var(--color-fg, #f5f5f7);
  }
  .pill.dimmed {
    opacity: 0.4;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .skills-group {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>