---
import { getDictionary, defaultLang } from '@/i18n';

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props;
const t = getDictionary(lang);

const stats = [
  { value: '3+', label: 'Years experience' },
  { value: '3', label: 'Languages' },
  { value: '10+', label: 'Projects shipped' },
];
---

<div class="grid gap-8 lg:grid-cols-[60%_40%] lg:items-start">
  <div class="space-y-4">
    <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed text-lg">{t.about.intro}</p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500 dark:text-neutral-400">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
        {t.about.basedIn}
      </span>
      <a href="mailto:bekzodturgunoff@gmail.com" class="inline-flex items-center gap-1.5 underline underline-offset-4 decoration-neutral-400/60 dark:decoration-white/20 hover:text-neutral-800 dark:hover:text-neutral-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
        bekzodturgunoff@gmail.com
      </a>
    </div>
    <p class="text-sm text-neutral-500 dark:text-neutral-400">{t.about.languagesLine}</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    {stats.map((s) => (
      <div class="rounded-2xl border border-black/5 dark:border-white/5 bg-white/30 dark:bg-black/30 backdrop-blur-md p-4 text-center" data-reveal>
        <div class="text-4xl font-bold text-brand-600 dark:text-brand-400">{s.value}</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">{s.label}</div>
      </div>
    ))}
  </div>
</div>
