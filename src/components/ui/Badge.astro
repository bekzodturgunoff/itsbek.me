---
interface Props {
  variant?: 'default' | 'brand';
  size?: 'sm' | 'md';
}

const { variant = 'default', size = 'sm' } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full uppercase tracking-wide font-medium",
    size === 'sm' ? 'px-2.5 py-1 text-[11px]' : 'px-3 py-1.5 text-xs',
    variant === 'brand'
      ? 'bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20'
      : 'bg-black/5 dark:bg-white/10 text-neutral-600 dark:text-neutral-300 border border-black/10 dark:border-white/10',
  ]}
>
  <slot />
</span>
