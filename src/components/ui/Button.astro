---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  download?: string;
}

const { variant = 'primary', size = 'md', href, target, rel, download } = Astro.props;

const classes = `btn btn-${variant} btn-${size}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} download={download}>
      <slot />
    </a>
  ) : (
    <button class={classes} type="button">
      <slot />
    </button>
  )
}
