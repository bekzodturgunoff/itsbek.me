---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/layout/Nav.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/layout/Section.astro';
import About from '@/components/home/About.astro';
import Skills from '@/components/home/Skills.astro';
import Contact from '@/components/home/Contact.astro';
import CaseStudy from '@/components/CaseStudy.astro';
import Projects from '@/components/Projects.astro';
import Footer from '@/components/layout/Footer.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { getDictionary } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const meta = {
  title: 'Bekzod — Software Engineer',
  description: 'Software engineer with 3+ years building responsive, accessible products. Specialising in React, Astro, TypeScript, Supabase, and React Native. Based in Uzbekistan — shipping full-stack web and mobile products end to end.',
};
---

<Base title={meta.title} description={meta.description} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />

    <Section id="about" title={t.nav.links.about}>
      <About lang={lang} />
    </Section>

    <Section id="skills" title={t.skills.title}>
      <Skills lang={lang} />
    </Section>

    <div id="case-study" class="hidden md:block">
      <CaseStudy lang={lang} data={t.bronUzCaseStudy} />
      <hr class="max-w-6xl mx-auto border-black/10 dark:border-white/10" />
      <CaseStudy lang={lang} data={t.telegramBotCaseStudy} gallery="telegram-bot" narrowImages />
      <hr class="max-w-6xl mx-auto border-black/10 dark:border-white/10" />
      <CaseStudy lang={lang} />
      <hr class="max-w-6xl mx-auto border-black/10 dark:border-white/10" />
      <CaseStudy lang={lang} data={t.octoposAppsCaseStudy} gallery="octopos-apps" fullWidthImages />
    </div>

    <Section id="work" title={t.projects.selectedWork}>
      <Projects />
    </Section>

    <Section id="contact" title="">
      <Contact lang={lang} />
    </Section>
  </main>

  <Footer lang={lang} />
  <Lightbox images={[]} />

  <script src="/scripts/reveal.js" defer></script>
</Base>
