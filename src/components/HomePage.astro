---
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Section from "./Section.astro";
import CaseStudy from "./CaseStudy.astro";
import Projects from "./Projects.astro";
import ContactForm from "./ContactForm.astro";
import Footer from "./Footer.astro";
import { getDictionary } from '../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const [headingLeft, ...headingRightWords] = t.contact.heading.split(" ");
const headingRight = headingRightWords.join(" ");
const meta = {
  title: "Bekzod — Software Engineer",
  description:
    "Software engineer with 4+ years building responsive, accessible products. Specialising in React, Astro, TypeScript, Supabase, and React Native. Based in Uzbekistan — shipping full-stack web and mobile products end to end.",
};
---
<Base title={meta.title} description={meta.description} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />

    <Section id="about" title={t.nav.links.about}>
      <div class="rounded-3xl border border-black/5 dark:border-white/5 bg-white/40 dark:bg-black/40 backdrop-blur-md p-6 sm:p-10 lg:p-12 transition-all duration-300 hover:border-brand-500/30">
        <p class="max-w-prose text-neutral-700 dark:text-neutral-300 leading-relaxed text-lg">{t.about.intro}</p>
        <div class="mt-6 text-[13px] text-neutral-500 dark:text-neutral-400">
          <span>{t.about.basedIn}<span class="hidden sm:inline"> · </span></span>
          <a
            class="block sm:inline underline underline-offset-4 decoration-neutral-400/60 dark:decoration-white/40 hover:text-neutral-800 dark:hover:text-neutral-100 transition-colors break-all"
            href="mailto:bekzodturgunoff@gmail.com"
          >
            bekzodturgunoff@gmail.com
          </a>
        </div>
        <p class="mt-3 text-[13px] text-neutral-500 dark:text-neutral-400">{t.about.languagesLine}</p>
      </div>
    </Section>

    <Section id="skills" title={t.skills.title}>
      <div class="grid gap-4 sm:grid-cols-3">
        {t.skills.groups.map((group) => (
          <div class="rounded-3xl border border-black/5 dark:border-white/5 bg-white/40 dark:bg-black/40 backdrop-blur-md p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-brand-500/30" data-reveal>
            <div class="text-[11px] uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400 mb-4">{group.title}</div>
            <div class="flex flex-wrap items-center gap-1.5 text-sm">
              {group.items.map((s, i, arr) => {
                const expertSkills = new Set(['React', 'Astro', 'TypeScript', 'JavaScript', 'Tailwind', 'Sass', 'HTML/CSS', 'Supabase', 'Git', 'GitHub Actions', 'CI/CD', 'Vercel', 'Accessibility & Performance Audits', 'Testing (Jest/Vitest)']);
                const opacity = expertSkills.has(s) ? 'opacity-100' : 'opacity-50';
                return <>
                  {i > 0 && <span class="opacity-60 text-neutral-400">·</span>}
                  <span class={opacity}>{s}</span>
                </>;
              })}
            </div>
          </div>
        ))}
      </div>
      <p class="text-[11px] text-neutral-400 dark:text-neutral-600 mt-4">* dimmed = learning / less frequent use</p>
    </Section>

    <div id="case-study" class="hidden md:block">
      <CaseStudy lang={lang} data={t.bronUzCaseStudy} />
      <CaseStudy lang={lang} data={t.telegramBotCaseStudy} gallery="telegram-bot" />
      <CaseStudy lang={lang} />
      <CaseStudy lang={lang} data={t.octoposAppsCaseStudy} gallery="octopos-apps" fullWidthImages />
    </div>

    <Section id="work" title={t.projects.selectedWork}>
      <Projects />
    </Section>

    <Section id="contact" title="">
      <h2 class="leading-[0.95] text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight break-words mb-7 sm:mb-9 lg:mb-11" data-reveal>
        <span class="text-neutral-300 dark:text-white/90">{headingLeft}</span>
        <span class="ml-3 text-neutral-900 dark:text-white">{headingRight}</span>
      </h2>
      <p class="max-w-2xl text-neutral-700 dark:text-neutral-300 mb-7 sm:mb-9 lg:mb-11 text-lg" data-reveal>{t.contact.intro}</p>

      <div class="flex flex-col sm:grid sm:grid-cols-3 gap-2.5 sm:gap-3 lg:gap-4 mb-3 sm:mb-5 lg:mb-6" data-reveal>
        <a href="tel:+998501886669" class="btn btn-outline btn-lg text-center bg-white/40 dark:bg-black/40 backdrop-blur-md px-4 py-2 sm:px-5 sm:py-2.5 lg:px-6 lg:py-3 rounded-full hover:border-brand-500/50 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
          {t.contact.ctas.call}
        </a>
        <a href="mailto:bekzodturgunoff@gmail.com" class="btn btn-outline btn-lg text-center bg-white/40 dark:bg-black/40 backdrop-blur-md px-4 py-2 sm:px-5 sm:py-2.5 lg:px-6 lg:py-3 rounded-full hover:border-brand-500/50 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
          {t.contact.ctas.email}
        </a>
        <a
          href="https://t.me/bekzodturgunoff"
          target="_blank"
          rel="noreferrer"
          class="btn btn-outline btn-lg text-center bg-white/40 dark:bg-black/40 backdrop-blur-md px-4 py-2 sm:px-5 sm:py-2.5 lg:px-6 lg:py-3 rounded-full hover:border-brand-500/50 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
        >
          {t.contact.ctas.telegram}
        </a>
      </div>

      {t.contact.availability && (
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6" data-reveal>{t.contact.availability}</p>
      )}

      <ContactForm lang={lang} />
    </Section>
  </main>

  <Footer lang={lang} />

  <div id="portfolio-lightbox" class="fixed inset-0 bg-black/95 z-50 hidden opacity-0 transition-opacity duration-300 flex flex-col items-center justify-between p-4 md:p-8 backdrop-blur-sm select-none">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white text-4xl font-light transition-colors z-50">&times;</button>

    <div class="relative flex items-center justify-center w-full flex-1 max-w-5xl h-[65vh]">
      <button id="lightbox-prev" class="absolute left-0 md:-left-12 text-white/50 hover:text-white text-5xl p-4 transition-colors z-10">‹</button>
      <img id="lightbox-main-img" src="" alt="" class="max-w-full max-h-[60vh] object-contain rounded-lg shadow-2xl transition-all duration-200 transform scale-95" />
      <button id="lightbox-next" class="absolute right-0 md:-right-12 text-white/50 hover:text-white text-5xl p-4 transition-colors z-10">›</button>
    </div>

    <div class="w-full max-w-3xl flex flex-col items-center gap-2 mb-4">
      <p id="lightbox-caption" class="text-white/60 text-sm font-medium tracking-wide"></p>
      <div id="lightbox-thumbs-container" class="flex gap-3 overflow-x-auto max-w-full p-2 scrollbar-none justify-center"></div>
    </div>
  </div>

  <script src="/scripts/reveal.js" defer></script>
  <script>
    function initLightbox() {
      const lightbox = document.getElementById('portfolio-lightbox');
      if (!lightbox) return;
      const mainImg = document.getElementById('lightbox-main-img');
      const caption = document.getElementById('lightbox-caption');
      const thumbsContainer = document.getElementById('lightbox-thumbs-container');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');

      let currentGroup = [];
      let currentIndex = 0;

      document.querySelectorAll('[data-gallery]').forEach(img => {
        img.addEventListener('click', (e) => {
          const groupName = img.getAttribute('data-gallery');
          currentGroup = Array.from(document.querySelectorAll(`[data-gallery="${groupName}"]`));
          currentIndex = parseInt(img.getAttribute('data-index') || '0', 10);
          openLightbox();
          updateViewer();
        });
      });

      function openLightbox() {
        lightbox.classList.remove('hidden');
        requestAnimationFrame(() => {
          lightbox.classList.remove('opacity-0');
          mainImg.classList.remove('scale-95');
          mainImg.classList.add('scale-100');
        });
        buildThumbnails();
      }

      function closeLightbox() {
        lightbox.classList.add('opacity-0');
        mainImg.classList.remove('scale-100');
        mainImg.classList.add('scale-95');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          thumbsContainer.innerHTML = '';
        }, 300);
      }

      function updateViewer() {
        if (!currentGroup[currentIndex]) return;
        const targetImg = currentGroup[currentIndex];
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = targetImg.getAttribute('data-src') || targetImg.src;
          mainImg.alt = targetImg.alt;
          caption.textContent = targetImg.alt || `Image ${currentIndex + 1}`;
          mainImg.style.opacity = '1';
          highlightActiveThumbnail();
        }, 150);
      }

      function buildThumbnails() {
        thumbsContainer.innerHTML = '';
        currentGroup.forEach((img, idx) => {
          const thumb = document.createElement('img');
          thumb.src = img.getAttribute('data-src') || img.src;
          thumb.className = `w-16 h-12 object-cover rounded cursor-pointer border-2 transition-all duration-200 ${idx === currentIndex ? 'border-blue-500 scale-105 opacity-100' : 'border-transparent opacity-40 hover:opacity-80'}`;
          thumb.addEventListener('click', () => {
            currentIndex = idx;
            updateViewer();
          });
          thumbsContainer.appendChild(thumb);
        });
      }

      function highlightActiveThumbnail() {
        const thumbs = thumbsContainer.querySelectorAll('img');
        thumbs.forEach((thumb, idx) => {
          if (idx === currentIndex) {
            thumb.className = 'w-16 h-12 object-cover rounded cursor-pointer border-2 border-blue-500 scale-105 opacity-100 transition-all duration-200';
            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            thumb.className = 'w-16 h-12 object-cover rounded cursor-pointer border-2 border-transparent opacity-40 hover:opacity-80 transition-all duration-200';
          }
        });
      }

      prevBtn.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + currentGroup.length) % currentGroup.length;
        updateViewer();
      });

      nextBtn.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % currentGroup.length;
        updateViewer();
      });

      closeBtn.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') prevBtn.click();
        if (e.key === 'ArrowRight') nextBtn.click();
      });
    }

    document.addEventListener('DOMContentLoaded', initLightbox);
    document.addEventListener('astro:page-load', initLightbox);
  </script>
</Base>
