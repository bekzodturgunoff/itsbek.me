---
---
<div id="three-bg" class="fixed inset-0 z-[-1] pointer-events-none transition-colors duration-700 bg-neutral-100 dark:bg-black"></div>

<button id="music-btn" class="fixed bottom-6 lg:bottom-10 right-6 lg:right-10 z-50 h-12 w-12 rounded-full bg-black/90 dark:bg-white/90 text-white dark:text-black shadow-2xl backdrop-blur-md hover:scale-110 transition-transform duration-300 flex items-center justify-center focus:outline-none ring-2 ring-transparent hover:ring-brand-500/50" aria-label="Toggle Background Music">
  <svg id="ico-play" class="w-5 h-5 transition-transform" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4l12 6-12 6V4z"/></svg>
  <svg id="ico-pause" class="w-5 h-5 hidden transition-transform" fill="currentColor" viewBox="0 0 20 20"><path d="M5 4h3v12H5V4zm7 0h3v12h-3V4z"/></svg>
  <svg id="ico-loading" class="w-5 h-5 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
</button>

<script>
  import * as THREE from 'three';

  if (!(window as any).__three_initialized) {
    (window as any).__three_initialized = false;
  }

  const init = () => {
    if ((window as any).__three_initialized) return;
    
    const container = document.getElementById('three-bg');
    const btn = document.getElementById('music-btn');
    if (!container || !btn) return;
    
    (window as any).__three_initialized = true;

    // --- THREE.JS SETUP ---
    const scene = new THREE.Scene();
    // Tilt the camera for a cinematic perspective over a terrain
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 1500);
    camera.position.set(0, 80, 200);

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    // Dynamic Audio-Reactive Wireframe Terrain
    const segs = 60;
    const size = 600;
    const geometry = new THREE.PlaneGeometry(size, size, segs, segs);
    geometry.rotateX(-Math.PI / 2); // Lay flat
    
    // Store original Y positions
    const pos = geometry.attributes.position;
    const originalYs = new Float32Array(pos.count);
    for (let i = 0; i < pos.count; i++) {
        originalYs[i] = pos.getY(i);
    }

    const material = new THREE.MeshStandardMaterial({
        color: 0x888888,
        wireframe: true,
        transparent: true,
        opacity: 0.15,
        emissive: 0x111111,
    });
    const mesh = new THREE.Mesh(geometry, material);
    // Center mesh
    mesh.position.y = -50; 
    scene.add(mesh);

    // subtle lighting
    const light = new THREE.DirectionalLight(0xffffff, 1);
    light.position.set(0, 200, 100);
    scene.add(light);
    const ambientInfo = new THREE.AmbientLight(0xffffff, 0.4);
    scene.add(ambientInfo);

    // Mouse Interaction
    let targetX = 0;
    let targetY = 0;

    window.addEventListener('mousemove', (e) => {
        targetX = (e.clientX - window.innerWidth / 2) * 0.0005;
        targetY = (e.clientY - window.innerHeight / 2) * 0.0005;
    });

    // Theme integration
    const updateTheme = () => {
        const isDark = document.documentElement.classList.contains('dark');
        material.color.setHex(isDark ? 0xaaaaaa : 0x555555);
        material.emissive.setHex(isDark ? 0x222222 : 0x111111);
        material.opacity = isDark ? 0.2 : 0.15;
    };
    updateTheme();
    const observer = new MutationObserver(updateTheme);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // --- AUDIO HANDLING ---
    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let source: MediaElementAudioSourceNode | null = null;
    let dataArray: Uint8Array | null = null;

    const audio = new Audio();
    // Enable crossOrigin BEFORE setting src so CORS policy is respected properly
    audio.crossOrigin = 'anonymous';
    audio.loop = true;
    audio.volume = 0.5;

    const fallbackUrl = 'https://raw.githubusercontent.com/rafaelreis-hotmart/Audio-Sample-files/master/sample.mp3';
    let fallbackUsed = false;

    // Helper: prefer local copy if available, otherwise fallback. Use HEAD then GET for diagnostics.
    const chooseAudioSource = async () => {
      try {
        const head = await fetch('/music.mp3', { method: 'HEAD' });
        if (head && head.ok) {
          const ct = head.headers.get('content-type') || '';
          if (ct.startsWith('audio')) {
            console.log('Using local /music.mp3 (HEAD OK, type:', ct + ')');
            audio.src = '/music.mp3';
            return;
          }
        }
      } catch (e) {
        console.warn('HEAD check for /music.mp3 failed:', e);
      }

      // Try a full GET as a second check (some servers block HEAD)
      try {
        const get = await fetch('/music.mp3');
        if (get && get.ok) {
          const ct = get.headers.get('content-type') || '';
          console.log('Using local /music.mp3 (GET OK, type:', ct + ')');
          audio.src = '/music.mp3';
          return;
        }
      } catch (e) {
        console.warn('GET check for /music.mp3 failed:', e);
      }

      // If we reach here, fall back to the remote sample
      fallbackUsed = true;
      console.warn('Local /music.mp3 not available — falling back to remote sample.');
      audio.src = fallbackUrl;
    };

    chooseAudioSource();

    audio.addEventListener('error', (ev) => {
      console.error('Audio element error event:', ev);
      if (!fallbackUsed) {
        fallbackUsed = true;
        console.warn('Switching to fallback audio due to element error.');
        audio.src = fallbackUrl;
      }
    });

    let isPlaying = false;

    const iconPlay = document.getElementById('ico-play');
    const iconPause = document.getElementById('ico-pause');
    const iconLoading = document.getElementById('ico-loading');

    btn.addEventListener('click', async () => {
      // Lazy-init AudioContext to comply with browser autoplay gesture requirements
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 128;
        dataArray = new Uint8Array(analyser.frequencyBinCount);

        try {
          source = audioCtx.createMediaElementSource(audio);
          source.connect(analyser);
          analyser.connect(audioCtx.destination);
        } catch (err) {
          console.error("Audio Routing Error (CORS usually):", err);
        }
      }

      if (audioCtx.state === 'suspended') {
        await audioCtx.resume();
      }

      if (isPlaying) {
        audio.pause();
        isPlaying = false;
        iconPause?.classList.add('hidden');
        iconPlay?.classList.remove('hidden');
        btn.classList.remove('shadow-[0_0_40px_rgba(150,150,150,0.4)]');
      } else {
        iconPlay?.classList.add('hidden');
        iconLoading?.classList.remove('hidden');
        try {
          await audio.play();
          isPlaying = true;
          iconPause?.classList.remove('hidden');
          iconLoading?.classList.add('hidden');
          btn.classList.add('shadow-[0_0_40px_rgba(150,150,150,0.4)]');
        } catch (e) {
          console.error("Audio Playback Error:", e);
          alert("Audio couldn't play. Check file path or permissions.");
          iconLoading?.classList.add('hidden');
          iconPlay?.classList.remove('hidden');
        }
      }
    });

    // --- RENDER LOOP ---
    const clock = new THREE.Clock();

    const render = () => {
        requestAnimationFrame(render);
        const time = clock.getElapsedTime();

        // Smooth camera follow for parallax effect
        camera.position.x += (targetX * 100 - camera.position.x) * 0.05;
        camera.lookAt(scene.position);

        // Terrain morphing and audio reactivity
        const posAttr = geometry.attributes.position;
        let avgFrequency = 0;

        if (isPlaying && analyser && dataArray) {
            analyser.getByteFrequencyData(dataArray);
        }

        for (let i = 0; i < posAttr.count; i++) {
            const x = posAttr.getX(i);
            const z = posAttr.getZ(i);

            // Create gentle rolling hills based on noise (simulated with sine waves)
            let newY = Math.sin(x * 0.02 + time) * 10 + Math.cos(z * 0.02 + time * 1.5) * 10;
            
            // Apply Audio reactivity
            if (isPlaying && dataArray) {
                // Map the vertex's distance from center to a frequency bin
                const dist = Math.sqrt(x*x + z*z);
                const maxDist = size / 2;
                const normalizeDist = Math.max(0, Math.min(1, dist / maxDist));
                // Inverse map: low frequencies in center, high on edges
                const binIndex = Math.floor((1 - normalizeDist) * (dataArray.length * 0.8));
                
                const freq = dataArray[binIndex] || 0;
                // Add sharp displacement based on beat
                newY += (freq / 255.0) * 45;
            }

            posAttr.setY(i, newY);
        }
        posAttr.needsUpdate = true;
        
        // Slowly advance the mesh towards the camera
        mesh.position.z += 0.5;
        // Loop the terrain seamlessly
        if (mesh.position.z > (size / segs)) {
            mesh.position.z = 0;
        }

        renderer.render(scene, camera);
    };
    render();

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('DOMContentLoaded', init);
  setTimeout(init, 500);
</script>
